[Unit]
Description=QSpot isolated router control plane
After=NetworkManager.service pi-hotspot-recover.service systemd-udev-trigger.service
Wants=NetworkManager.service pi-hotspot-recover.service
StartLimitIntervalSec=0
ConditionPathExists=/var/lib/qspot/config.json
[Service]
ExecCondition=/usr/bin/python3 /opt/qspot/installer/recovery.py --guard
ExecStart=/usr/bin/python3 /opt/qspot/qspot/daemon.py
Restart=always
RestartSec=10
RuntimeDirectory=qspot
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run /var/lib/qspot /etc/NetworkManager/system-connections /etc/hostname /etc/hosts /etc/qspot/tls /etc/avahi/hosts
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
[Install]
WantedBy=multi-user.target
