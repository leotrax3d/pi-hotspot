[Unit]
Description=QSpot captive portal and authenticated management
After=qspot-net.service
Wants=qspot-net.service
[Service]
User=qspot
Group=qspot
WorkingDirectory=/opt/qspot/qspot
ExecStart=/usr/bin/python3 /opt/qspot/qspot/web.py
Restart=on-failure
RestartSec=3
StateDirectory=qspot-web
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/qspot/tls
[Install]
WantedBy=multi-user.target
