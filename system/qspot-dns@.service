[Unit]
Description=QSpot DNS and DHCP for %i
After=NetworkManager.service
[Service]
User=dnsmasq
Group=nogroup
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
RuntimeDirectory=qspot-dns-%i
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0077
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/run/qspot/dns-%i.conf --user=dnsmasq --group=nogroup --pid-file=
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
